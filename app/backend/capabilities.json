    "a": {
      "label": "Real input",
      "tooltip": "Sent to the engine, or a real audio operation we run ourselves."
    },
    "b": {
      "label": "Creative direction",
      "tooltip": "Written into the prompt as words. The music may follow it loosely or not at all."
    },
    "c": {
      "label": "Not possible",
      "tooltip": "Needs a score, stems or multitrack audio that this engine does not produce."
    },
    "d": {
      "label": "Unverified",
      "tooltip": "We pass it in, but nobody has verified that the result follows it."
    },
    "n/a": {
      "label": "",
      "tooltip": ""
    }
  },
