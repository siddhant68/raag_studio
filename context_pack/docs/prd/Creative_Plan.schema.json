{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:raag-studio:creative-plan:0.1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "brief": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "mode": {
      "type": "string",
      "enum": [
        "auto",
        "instrumental",
        "wordless",
        "lyrical",
        "spoken"
      ]
    },
    "duration_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 10,
      "maximum": 600
    },
    "instruments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "enum": [
              "auto",
              "lead",
              "answer",
              "harmony",
              "rhythm",
              "bass",
              "drone",
              "texture",
              "accent"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "essential",
              "preferred",
              "optional"
            ]
          },
          "presence": {
            "type": "string",
            "enum": [
              "auto",
              "subtle",
              "balanced",
              "featured"
            ]
          },
          "performance": {
            "type": "string",
            "enum": [
              "auto",
              "simple",
              "lyrical",
              "expressive",
              "ornate",
              "agile"
            ]
          },
          "techniques": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "lyrics": {
      "type": "object",
      "properties": {
        "policy": {
          "type": "string",
          "enum": [
            "none",
            "write",
            "exact",
            "adapt",
            "inspired"
          ]
        },
        "text": {
          "type": "string"
        },
        "language": {
          "type": "string"
        },
        "script": {
          "type": "string"
        },
        "theme": {
          "type": "string"
        },
        "locked_lines": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allowed_changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "policy": {
                "const": "exact"
              }
            },
            "required": [
              "policy"
            ]
          },
          "then": {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "allowed_changes": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "choir": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "string",
          "enum": [
            "auto",
            "off",
            "on"
          ]
        },
        "scale": {
          "type": "string",
          "enum": [
            "auto",
            "solo",
            "duet",
            "small",
            "chamber",
            "large",
            "massed"
          ]
        },
        "target_count": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 1000
        },
        "count_is_approximate": {
          "const": true
        },
        "relationship": {
          "type": "string",
          "enum": [
            "auto",
            "held_harmony",
            "follow_melody",
            "answer",
            "counterline"
          ]
        },
        "content": {
          "type": "string",
          "enum": [
            "auto",
            "ooh_aah",
            "hum",
            "chant",
            "specified_words"
          ]
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "composition": {
      "type": "object",
      "properties": {
        "moods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "bpm": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30,
          "maximum": 300
        },
        "rhythmic_feel": {
          "type": "string",
          "enum": [
            "auto",
            "straight",
            "swing",
            "half_time",
            "double_time"
          ]
        },
        "development": {
          "type": "string"
        },
        "ending": {
          "type": "string"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "constraints": {
      "type": "object",
      "properties": {
        "locked_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "field_provenance": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "origin": {
            "type": "string",
            "enum": [
              "user",
              "inferred",
              "preset"
            ]
          },
          "locked": {
            "type": "boolean"
          },
          "priority": {
            "type": "string",
            "enum": [
              "essential",
              "preferred",
              "optional"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "required": [
          "origin"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "brief"
  ],
  "additionalProperties": false,
  "description": "Proposed core creative-plan contract, not the full 104-field catalogue schema. Catalogue detail becomes typed extensions during implementation. Defaults are planner decisions, not automatic JSON Schema mutation. Cross-field semantic checks and engine validation are separate required implementation work."
}